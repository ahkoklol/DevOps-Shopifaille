{
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "deno.ns", "dom"],
    "target": "ES2022",
    "module": "esnext",
    "types": ["@types/node"]
  },
  "tasks": {
    "dev": "deno run -A src/main.ts",
    "grpc:all": "deno run -A src/modules/grpc/server.ts",
    // "grpc:stores": "deno run -A src/modules/store-management/grpc/server.ts",
    // "grpc:orders": "deno run -A src/modules/order-management/grpc/server.ts",
    // "grpc:webhooks": "deno run -A src/modules/event-webhooks/grpc/server.ts",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "imports": {
    "grpc": "npm:@grpc/grpc-js",
    "proto-loader": "npm:@grpc/proto-loader",
    "hono": "npm:hono@^4.3.0"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": ["node_modules/"]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2
  },
  "nodeModulesDir": "auto",
  "lock": false
}
